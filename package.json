{
  "name": "rexycamp",
  "version": "0.1.0",
  "description": "A lazygit-style terminal app for your Basecamp assignments, made to run in a Rex pane",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "start": "bun run src/main.ts",
